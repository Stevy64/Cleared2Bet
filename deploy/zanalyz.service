[Unit]
Description=ZanalyZ (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=zanalyz
WorkingDirectory=/var/www/zanalyz
EnvironmentFile=/var/www/zanalyz/.env
ExecStart=/var/www/zanalyz/.venv/bin/gunicorn \
    --config /var/www/zanalyz/deploy/gunicorn.conf.py \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
