# Copie vers .env à la racine du projet (ne pas committer .env).
# cp .env.example .env && nano .env
# Déploiement recommandé : Oracle Cloud Free Tier (voir docs/oracle-cloud.md)

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-moi-avec-une-cle-longue-aleatoire
DJANGO_ALLOWED_HOSTS=cleared2bet.example.com,www.cleared2bet.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cleared2bet.example.com,https://www.cleared2bet.example.com
DJANGO_SSL=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# SQLite (défaut) — chemin absolu recommandé en prod :
# DJANGO_SQLITE_PATH=/var/www/cleared2bet/data/db.sqlite3

# Ou PostgreSQL :
# DJANGO_DB_URL=postgres://c2b:MOTDEPASSE@127.0.0.1:5432/cleared2bet
